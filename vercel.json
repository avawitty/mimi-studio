{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "dist",
  "functions": {
    "api/you-search.ts": {
      "maxDuration": 60
    },
    "api/residue-acquire.ts": {
      "maxDuration": 60
    },
    "api/sovereign/community.ts": {
      "maxDuration": 30
    },
    "api/sovereign/zine.ts": {
      "maxDuration": 30
    },
    "api/sovereign/import.ts": {
      "maxDuration": 60
    },
    "api/sovereign/reindex.ts": {
      "maxDuration": 60
    },
    "api/sovereign/events.ts": {
      "maxDuration": 60
    },
    "api/sovereign/status.ts": {
      "maxDuration": 30
    },
    "api/sovereign/ping.ts": {
      "maxDuration": 10
    },
    "api/health.ts": {
      "maxDuration": 30
    }
  },
  "redirects": [
    {
      "source": "/creative-loop",
      "destination": "/",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/.well-known/openai-apps-challenge",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0"
        }
      ]
    },
    {
      "source": "/((?!assets/|icons/|api/|\\.well-known/).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/.well-known/openai-apps-challenge",
      "destination": "/api/openai-apps-challenge"
    },
    {
      "source": "/api/sovereign/zines/:id",
      "destination": "/api/sovereign/zine?id=:id"
    },
    {
      "source": "/api/sovereign/zines",
      "destination": "/api/sovereign/zine"
    },
    {
      "source": "/u/:handle/feed.xml",
      "destination": "/api/feed?handle=:handle"
    },
    {
      "source": "/zine/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|Twitterbot|LinkedInBot|Slackbot|Discordbot|WhatsApp|TelegramBot|Pinterest|Googlebot|bingbot|Applebot|Embedly|Slack-ImgProxy).*"
        }
      ],
      "destination": "/api/og/zine?id=:id"
    },
    {
      "source": "/((?!api/|assets/|\\.well-known/).*)",
      "destination": "/index.html"
    }
  ]
}
