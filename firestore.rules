rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() { return request.auth != null; }
    function isOwner(userId) { return (isAuthenticated() && request.auth.uid == userId) || userId.matches('^local_ghost_.*') || userId == 'ghost'; }
    function isAdmin() {
      return isAuthenticated() && (
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'user') == 'admin') ||
        (request.auth.token.get('email', '') == "avaawittkop@gmail.com" &&
         request.auth.token.get('email_verified', false) == true)
      );
    }
    function isPayingSubscriber() {
      return isAuthenticated() && (
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('planStatus', 'free') == 'patron' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('planStatus', 'free') == 'sovereign_aesthetics'
        )) ||
        isAdmin()
      );
    }
    function hasRequiredFields(fields) { return request.resource.data.keys().hasAll(fields); }
    function hasOnlyAllowedFields(fields) { return request.resource.data.keys().hasOnly(fields); }

    // Paid entitlement keys must never be owner-written (create or update).
    // Free-tier plan markers (free/trial/ghost/expired) are allowed on create for signup.
    function entitlementFieldKeys() {
      return [
        'stripeCustomerId',
        'membershipCredits',
        'subscriptionStatus',
        'subscriptionInterval',
        'isPatron',
        'patronActivatedAt',
        'patronKey',
        'mimiPlan',
        'membershipPlan',
        'plan',
        'planStatus'
      ];
    }
    function isFreeTierPlanValue(value) {
      return value in ['free', 'trial', 'ghost', 'expired'];
    }
    function ownerCreateWithoutPaidEntitlements() {
      return !request.resource.data.keys().hasAny([
        'stripeCustomerId',
        'membershipCredits',
        'subscriptionStatus',
        'subscriptionInterval',
        'isPatron',
        'patronActivatedAt',
        'patronKey'
      ])
      && (!('plan' in request.resource.data) || isFreeTierPlanValue(request.resource.data.plan))
      && (!('planStatus' in request.resource.data) || isFreeTierPlanValue(request.resource.data.planStatus))
      && (!('mimiPlan' in request.resource.data) || isFreeTierPlanValue(request.resource.data.mimiPlan))
      && (!('membershipPlan' in request.resource.data) || isFreeTierPlanValue(request.resource.data.membershipPlan));
    }
    
    function validString(field, min, max) {
      return request.resource.data[field] is string && 
             request.resource.data[field].size() >= min && 
             request.resource.data[field].size() <= max;
    }
    
    function uidUnchanged() {
      return !('uid' in request.resource.data) ||
        request.resource.data.uid == request.auth.uid;
    }

    function uidNotModified() {
      return !('uid' in request.resource.data) ||
        request.resource.data.uid == resource.data.uid;
    }
    
    // Prevents changing the userId on an existing document
    function ownerUnchanged() {
      return !('userId' in request.resource.data) || request.resource.data.userId == resource.data.userId;
    }

    function hasThimbleBoardAccess(boardData) {
      return isAuthenticated() && (
        boardData.userId == request.auth.uid ||
        (boardData.collaborators is list && request.auth.uid in boardData.collaborators)
      );
    }

    function canAccessThimbleBoardById(boardId) {
      return boardId is string &&
        exists(/databases/$(database)/documents/thimbleBoards/$(boardId)) &&
        hasThimbleBoardAccess(get(/databases/$(database)/documents/thimbleBoards/$(boardId)).data);
    }

    // ===============================================================
    // Rules
    // ===============================================================

    // -- NEW: MEMBERSHIPS (Secure Billing Storage) --
    match /memberships/{userId} {
      // Users can see their own membership status, admins can see all
      allow read: if isOwner(userId) || isAdmin();
      // Membership entitlements are Admin / webhook only (no client forge).
      allow write: if isAdmin();
    }

    // MEMBERS
    match /members/{memberId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // NOTIFICATIONS (Owner only)
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
    
    // SYSTEM (Admin only, except connection_test heartbeat)
    match /system/{docId} {
      allow read: if docId == 'connection_test' || isAdmin();
    }
    
    // PRODUCTS (Public Read)
    match /products/{productId} {
      allow read: if true;
    }

    // PROFILES (Public Read, Owner Write)
    match /profiles_public/{userId} {
      allow read, list: if true;
      // Owner create: free-tier signup only — no delete/recreate paid forge path.
      allow create: if isAdmin() || (isOwner(userId) && ownerCreateWithoutPaidEntitlements());
      allow update: if isAdmin() || (
        isOwner(userId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(entitlementFieldKeys())
      );
      allow delete: if isOwner(userId) || isAdmin();
    }

    // PROFILES (Private: Owner only)
    match /profiles_private/{userId} {
      allow read, write: if isOwner(userId);
    }

    // USER PREFERENCES (Owner only)
    match /userPreferences/{userId} {
      allow read, write: if isOwner(userId);
    }

    // PROFILES (PII Protected: Owner only)
    match /profiles/{userId} {
      allow read, write, list: if isOwner(userId);
    }

    // ZINES (Public Read if isPublic, Paying Subscriber Write)
    match /zines/{zineId} {
      allow read: if resource.data.isPublic == true || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isPayingSubscriber() && request.resource.data.userId == request.auth.uid;
      allow update: if isPayingSubscriber() && resource.data.userId == request.auth.uid && ownerUnchanged();
      allow delete: if isPayingSubscriber() && resource.data.userId == request.auth.uid;
      
      match /pages/{pageId} {
        allow read: if get(/databases/$(database)/documents/zines/$(zineId)).data.isPublic == true || (isAuthenticated() && get(/databases/$(database)/documents/zines/$(zineId)).data.userId == request.auth.uid);
        allow write: if isPayingSubscriber() && get(/databases/$(database)/documents/zines/$(zineId)).data.userId == request.auth.uid;
      }
      
      match /artifacts/{artifactId} {
        allow read: if get(/databases/$(database)/documents/zines/$(zineId)).data.isPublic == true || (isAuthenticated() && get(/databases/$(database)/documents/zines/$(zineId)).data.userId == request.auth.uid);
        allow write: if isPayingSubscriber() && get(/databases/$(database)/documents/zines/$(zineId)).data.userId == request.auth.uid;
      }
    }

    // PUBLIC TRANSMISSIONS (Public Read, Authenticated Write)
    match /public_transmissions/{transmissionId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }

    // POCKET ITEMS (Owner only)
    match /pocket/{itemId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || request.auth.uid in resource.data.collaborators);
      allow update, delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || request.auth.uid in resource.data.collaborators);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }

    // LINEAGE ENTRIES (Owner only)
    match /lineage_entries/{lineageId} {
      allow read: if isOwner(resource.data.userId);
      allow update, delete: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);
    }
    
    // STACKS (Owner only)
    match /stacks/{stackId} {
      allow read: if isOwner(resource.data.userId);
      allow update, delete: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);
    }
    
    // DOSSIER FOLDERS (Owner/Collaborator only)
    match /dossier_folders/{folderId} {
      allow get: if isAuthenticated() && (
        (resource.data.userId == request.auth.uid) || 
        (resource.data.collaborators is list && request.auth.uid in resource.data.collaborators)
      );
      allow list: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || (resource.data.collaborators is list && request.auth.uid in resource.data.collaborators));
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }
    
    // DOSSIER ARTIFACTS (Owner/Collaborator only)
    match /dossier_artifacts/{artifactId} {
      allow read: if isAuthenticated() && (
        (resource.data.userId == request.auth.uid) ||
        (get(/databases/$(database)/documents/dossier_folders/$(resource.data.folderId)).data.userId == request.auth.uid) ||
        (resource.data.folderId != null && request.auth.uid in get(/databases/$(database)/documents/dossier_folders/$(resource.data.folderId)).data.collaborators)
      );
      allow update, delete: if isAuthenticated() && (
        (resource.data.userId == request.auth.uid) ||
        (get(/databases/$(database)/documents/dossier_folders/$(resource.data.folderId)).data.userId == request.auth.uid) ||
        (resource.data.folderId != null && request.auth.uid in get(/databases/$(database)/documents/dossier_folders/$(resource.data.folderId)).data.collaborators)
      );
      allow create: if isAuthenticated() && (
        (request.resource.data.userId == request.auth.uid) &&
        (
          (get(/databases/$(database)/documents/dossier_folders/$(request.resource.data.folderId)).data.userId == request.auth.uid) ||
          (request.auth.uid in get(/databases/$(database)/documents/dossier_folders/$(request.resource.data.folderId)).data.collaborators)
        )
      );
    }
    
    // PROPOSALS (Owner only)
    match /proposals/{proposalId} {
      allow read: if isOwner(resource.data.userId);
      allow update, delete: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);
    }
    
    // CONTEXT (Owner only)
    match /context/{contextId} {
      allow read: if isOwner(resource.data.userId);
      allow update, delete: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);
    }
    
    // NARRATIVE THREADS (Owner only)
    match /narrative_threads/{threadId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid);
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid &&
                       validString('title', 1, 200) &&
                       validString('narrative', 1, 100000);
      allow update: if isAuthenticated() && (resource.data.userId == request.auth.uid) &&
                       request.resource.data.userId == resource.data.userId &&
                       validString('title', 1, 200) &&
                       validString('narrative', 1, 100000);
    }

    // ZINE COMMENTS (Authenticated Read/Write)
    match /zine_comments/{commentId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
    
    // TASTE EVENTS (Owner only, Immutable)
    match /taste_events/{eventId} {
      allow read: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);
      allow update, delete: if false;
    }
    
    // PRODUCT INTERACTIONS (Owner only)
    match /product_interactions/{interactionId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid);
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }
    
    // PRESS ISSUES (Owner only)
    match /pressIssues/{issueId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid);
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }
    
    // RETENTION EVENTS (Owner only)
    match /retention_events/{userId}/{subcollection}/{docId} {
      allow read, write: if isOwner(userId);
    }
    
    // CONNECTIONS (Owner only)
    match /connections/{connectionId} {
      allow read: if isAuthenticated() && (resource.data.followerId == request.auth.uid || resource.data.followingId == request.auth.uid);
      allow update, delete: if isAuthenticated() && (resource.data.followerId == request.auth.uid || resource.data.followingId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.followerId == request.auth.uid;
    }
    
    // FRIEND REQUESTS (Owner only)
    match /friend_requests/{requestId} {
      allow read: if isAuthenticated() && (resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid);
      allow update, delete: if isAuthenticated() && (resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.senderId == request.auth.uid;
    }
    
    // FRIENDSHIPS (Owner only)
    match /friendships/{friendshipId} {
      allow read, list: if isAuthenticated() && (resource.data.user1 == request.auth.uid || resource.data.user2 == request.auth.uid);
      allow update, delete: if isAuthenticated() && (resource.data.user1 == request.auth.uid || resource.data.user2 == request.auth.uid);
      allow create: if isAuthenticated() && (request.resource.data.user1 == request.auth.uid || request.resource.data.user2 == request.auth.uid);
    }

    // CLIQUES (Owner only)
    match /cliques/{cliqueId} {
      allow read, list: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
    }

    // THIMBLE BOARDS (Owner + Collaborators)
    match /thimbleBoards/{boardId} {
      allow read: if hasThimbleBoardAccess(resource.data);
      allow create: if isOwner(request.resource.data.userId) &&
        (!('collaborators' in request.resource.data) || request.resource.data.collaborators is list);
      allow update: if hasThimbleBoardAccess(resource.data) &&
        resource.data.userId == request.auth.uid &&
        ownerUnchanged();
      allow delete: if hasThimbleBoardAccess(resource.data) &&
        resource.data.userId == request.auth.uid;
    }

    // THIMBLE ITEMS (Owner + Board Collaborators)
    match /thimbleItems/{itemId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        canAccessThimbleBoardById(resource.data.boardId)
      );
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid &&
        canAccessThimbleBoardById(request.resource.data.boardId);
      allow update, delete: if isAuthenticated() &&
        ownerUnchanged() &&
        (
          resource.data.userId == request.auth.uid ||
          (
            resource.data.boardId is string &&
            exists(/databases/$(database)/documents/thimbleBoards/$(resource.data.boardId)) &&
            get(/databases/$(database)/documents/thimbleBoards/$(resource.data.boardId)).data.userId == request.auth.uid
          )
        );
    }

    // USERS (Owner only - PATCHED FOR PRIVILEGE ESCALATION)
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      // Owner create: free-tier only — block delete/recreate forge of paid fields.
      allow create: if isAdmin() || (
        isOwner(userId) &&
        (!('role' in request.resource.data) || request.resource.data.role == 'user') &&
        ownerCreateWithoutPaidEntitlements()
      );
      // Billing / entitlement fields are server-written (Stripe webhook / Admin).
      // Owners must not self-set stripeCustomerId, membershipCredits, or patron markers.
      allow update: if isAdmin() || (
        isOwner(userId) &&
        (!('role' in request.resource.data) || request.resource.data.role == resource.data.role) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(
          entitlementFieldKeys().concat(['role'])
        )
      );
      allow delete: if isOwner(userId) || isAdmin();
      
      match /dolls/{document=**} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
      match /fieldNotes/{document=**} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
      match /tasteGraphs/{document=**} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      // Residue Engine (private owner-scoped research runs + artifacts)
      match /residueRuns/{document=**} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
      match /residueSources/{document=**} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
      match /residueEvidence/{document=**} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
      match /residueClaims/{document=**} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
      match /residueAssociations/{document=**} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
      match /residueArtifacts/{document=**} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
      match /residueMemoryProposals/{document=**} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      // Stripe / membership billing — Admin SDK / webhook only.
      match /billing/{document=**} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isAdmin();
      }
      
      // Owner subcollections except billing (matched above).
      match /{subcollection}/{document=**} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isOwner(userId) && subcollection != 'billing';
      }
    }
    
    // USERS COLLECTION (Admin only)
    match /users {
      allow list: if isAdmin();
    }

    // ISSUES (Public Read if published, Admin Write)
    match /issues/{issueId} {
      allow read: if resource.data.status == 'published' || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // SUBMISSIONS (Owner Read/Write, Admin Read/Write)
    match /submissions/{submissionId} {
      allow read: if isAuthenticated() && (resource.data.authorId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.authorId == request.auth.uid;
      allow update: if isAuthenticated() && (resource.data.authorId == request.auth.uid || isAdmin()) && (!('status' in request.resource.data) || request.resource.data.status == resource.data.status || isAdmin());
      allow delete: if isAuthenticated() && (resource.data.authorId == request.auth.uid || isAdmin());
    }

    // COMMENTS (Public Read, Authenticated Write)
    match /comments/{commentId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if isAuthenticated() && (resource.data.authorId == request.auth.uid || isAdmin());
    }

    // STATS (Public Read)
    match /stats/{docId} {
      allow read: if true;
    }

    // WARDROBE ITEMS (Owner only)
    match /wardrobe_items/{itemId} {
      allow read, update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }

    // WARDROBE CAPSULES (Owner only)
    match /wardrobe_capsules/{capsuleId} {
      allow read, update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }

    // ZINE FOLDERS (Owner only)
    match /zine_folders/{folderId} {
      allow read, update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }

    // STRIPE CUSTOMERS (Owner only checkout sessions, etc.)
    match /customers/{userId}/{document=**} {
      allow read, write: if isOwner(userId);
    }
  }
}
