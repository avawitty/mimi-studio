# Copy to .env.local and fill in values for local development.
# Never commit real secrets. Prefer `vercel env pull .env.local` when linked.

# --- Vercel AI Gateway (preferred for server-side AI) ---
AI_GATEWAY_API_KEY=
# Optional OIDC on Vercel deployments (alternative to API key):
# VERCEL_OIDC_TOKEN=

# Gateway model overrides (provider/model IDs — see lib/models.ts).
# Prefer the newest curated defaults for text / image / audio / video generations.
AI_GATEWAY_TEXT_FAST_MODEL=google/gemini-3.6-flash
AI_GATEWAY_MODEL=anthropic/claude-sonnet-5
AI_GATEWAY_IMAGE_MODEL=google/gemini-3.1-flash-image
AI_GATEWAY_IMAGE_EDIT_MODEL=google/gemini-3.1-flash-image
AI_GATEWAY_VIDEO_MODEL=google/veo-3.1-lite-generate-001
AI_GATEWAY_TTS_MODEL=xai/grok-tts
AI_GATEWAY_EMBEDDING_MODEL=openai/text-embedding-3-small

# --- Legacy / BYOK provider keys (optional failover) ---
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Tooling / automation (not product inference)
# Get a key from https://cursor.com/dashboard/cloud-agents
CURSOR_API_KEY=
# Optional model override (default: composer-2)
CURSOR_SDK_MODEL=composer-2

# Cloud review / bot-comment autofix script extras
# REPO_URL=https://github.com/avawitty/mimi-studio
# HEAD_REF=
# BASE_REF=main
# PR_URL=
# COMMENT_URL=
# COMMENT_BODY=
# COMMENT_AUTHOR=
# Also used by .github/workflows/fix-bot-pr-comments.yml (repo secret CURSOR_API_KEY)
# Cursor Automation recipe: docs/automations/fix-bot-pr-comments.md

# Server Firebase Admin (Keep Tabs RSS, OG, session verify)
# Prefer a file path outside the repo — never commit the JSON key.
# FIREBASE_SERVICE_ACCOUNT_FILE=/absolute/path/to/firebase-admin.json
# Or paste the full service-account JSON (single line) as:
# FIREBASE_SERVICE_ACCOUNT=
# Named Firestore DB id from firebase-applet-config.json (required; default DB is empty):
# FIREBASE_FIRESTORE_DATABASE_ID=ai-studio-mimi-4c383b50-c596-4b43-8a2e-61d0645e590a
# MIMI_PUBLIC_BASE_URL=https://mimi.you

# --- Canonical Neon relational database (server-only) ---
# Prefer the pooled URI from Neon → Connect (hostname contains -pooler).
# Drizzle migrations and all operational repositories use this database.
DATABASE_URL=
# Optional split transport: HTTP URL for ordinary serverless reads and pooled
# WebSocket URL for interactive transactions / SELECT ... FOR UPDATE.
# NEON_DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb
# NEON_POOLED_DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb
# NEON_POOL_MAX=3
# Test-only escape hatch for local non-Neon Postgres:
# MIMI_ALLOW_NON_NEON_DATABASE=1
#
# Canonical plan grant overrides:
# MIMI_FREE_MONTHLY_CREDITS=25
# MIMI_TRIAL_CREDITS=150
# MIMI_CREATOR_MONTHLY_CREDITS=1500
# MIMI_STUDIO_MONTHLY_CREDITS=10000
# MIMI_TEAM_MONTHLY_CREDITS=30000
# Enable only after the Neon migration and Stripe reconciliation checks pass:
# MIMI_NEON_STRIPE_RECONCILIATION=1
#
# Apply to an isolated Neon branch first:
# npm run db:check
# npm run db:migrate
# npm run credits:sweep

# --- Legacy Sovereign archive (migration compatibility) ---
# Enabled by default for local / long-lived Express hosts (`npm run dev` / Fly / VPS).
# Disabled on Vercel unless MIMI_SOVEREIGN_DB or a Postgres URL is set.
# MIMI_SOVEREIGN_ENABLED=1
# MIMI_SOVEREIGN_DB=/absolute/path/to/sovereign.sqlite
# Legacy publication Postgres / Neon path:
# Project: mimineon (sweet-dust-78322246)
# TLS cert verification is enforced in code — sslmode in the URL is stripped.
# MIMI_SOVEREIGN_DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb
# DATABASE_URL above is auto-selected when it is a neon.tech URI.
# Force non-Neon DATABASE_URL into sovereign:
# MIMI_SOVEREIGN_USE_DATABASE_URL=1
# Optional pool size (default Neon=3, else 8; max 20):
# MIMI_SOVEREIGN_PG_POOL_MAX=3
# MIMI_SOVEREIGN_APP_NAME=mimi-sovereign
# Optional shared secret for automated ingest / import:
# MIMI_SOVEREIGN_INGEST_KEY=
# Production defaults to strict auth (ID token, __session cookie, or ingest key). Soft header:
# MIMI_SOVEREIGN_TRUST_USER_HEADER=1
# MIMI_SOVEREIGN_STRICT_AUTH=1
# Seed a tiny demo Floor when the archive is empty (local polish):
# MIMI_SOVEREIGN_SEED_DEMO=1
# AI Gateway embeddings for Floor semantic search (auto when AI_GATEWAY_API_KEY / OIDC present):
# MIMI_SOVEREIGN_EMBED=1
# npm run sovereign:seed
# npm run sovereign:import -- ./path/to/export.json
# npm run sovereign:export-firestore -- --limit=200
# npm run sovereign:reindex
# Auth notes: keep Firebase Auth; dual-verify ID token + __session.
#
# Archived probes may still mention Neon Auth, but it is not Mimi identity.
# Do not add NEON_AUTH_*, Supabase Auth, or legacy STACK_* variables.


# Web Intelligence (/api/you-search) — optional live providers
# YOU_API_KEY=          # or YOU_COM_API_KEY — You.com Search API
# AI_GATEWAY_API_KEY=   # falls back to model synthesis when live search is unset
# APIFY_ACTOR_ID=apify/rag-web-browser
# APIFY_SCRAPING_TOOL=raw-http
# APIFY_WAIT_SECS=35           # Actor wait budget (keep under Vercel 60s)   # or browser-playwright if editorial pages are empty

# Optional — Apify (apify-client). Shared by Web Intel and Residue Engine Phase 9.
# Missing token disables Apify paths only; other providers/demo still work.
# Get a token: https://console.apify.com/settings/integrations
# APIFY_TOKEN=
# RESIDUE_APIFY_ACTOR_ID=apify/rag-web-browser   # optional Residue-specific override

# Optional promo bypass codes (comma-separated) for /api promo redeem — never hardcode secrets in source.
# PROMO_BYPASS_CODES=

# --- Firebase client (Vite inlines VITE_* at build time) ---
# FIREBASE_PROJECT_ID=
# FIREBASE_STORAGE_BUCKET=
# FIREBASE_MESSAGING_SENDER_ID=
# FIREBASE_APP_ID=
# FIREBASE_MEASUREMENT_ID=
